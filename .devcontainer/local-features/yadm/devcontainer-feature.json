{
    "name": "Setup dotfiles using yadm",
    "id": "yadm",
    "version": "1.0.0",
    "description": "Setup dotfiles using yadm",
    "options": {
        "url": {
            "type": "string",
            "default": "https://github.com/kompiro/yadm",
            "description": "Setup your yadm repository URL."
        },
        "ref": {
            "type": "string",
            "default": "main",
            "description": "Setup your yadm repository ref."
        },
        "githubToken": {
            "type": "string",
            "default": "",
            "description": "GitHub token passed to mise as GITHUB_TOKEN. Without it, mise calls the GitHub API unauthenticated and hits the 60 requests/hour rate limit."
        }
    }
}