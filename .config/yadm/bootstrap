#!/bin/bash

# if ! command -v brew > /dev/null 2>&1; then
#   echo "Installing homebrew"
#   /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
#   eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
# fi
#
# if [ -f "$HOME/.Brewfile" ]; then
#   echo "Updating homebrew bundle"
#   brew bundle --global
# fi

if ! command -v curl > /dev/null 2>&1; then
  echo "curl is not found. Please install curl"
  exit 1
fi

if ! command -v git > /dev/null 2>&1; then
  echo "git is not found. Please install git"
  exit 1
fi

if [ ! -e "${HOME}/.history" ]; then
  mkdir -p "${HOME}/.history"
fi

# ~/.bashrc はディストリビューションが最初から置いていて yadm では上書きできないので、
# yadm で管理している ~/.config/bash/bashrc を読み込む行を追記する
# yadm は $HOME 直下にチェックアウトするので、XDG_CONFIG_HOME ではなく $HOME/.config を参照する
bashrc_source='[ -f "$HOME/.config/bash/bashrc" ] && . "$HOME/.config/bash/bashrc"'
if ! grep -qxF "${bashrc_source}" "${HOME}/.bashrc" 2>/dev/null; then
  # 末尾が改行で終わっていないと直前の行に連結されてしまうので、改行を補ってから追記する
  if [ -s "${HOME}/.bashrc" ] && [ -n "$(tail -c 1 "${HOME}/.bashrc")" ]; then
    echo >> "${HOME}/.bashrc"
  fi
  echo "${bashrc_source}" >> "${HOME}/.bashrc"
fi

# `git config --global` の書き込み先は、~/.gitconfig が無いと ~/.config/git/config (yadm で管理) になる。
# コンテナでは初期化処理がそこに credential helper や include を足すことがあるので、
# yadm の作業ツリーが汚れないよう空の ~/.gitconfig を用意して書き込み先をそちらに寄せる
touch "${HOME}/.gitconfig"

# mise 本体は ~/.local/bin/mise に置く。版は固定し、上げるときは `mise self-update` を使う。
# インストーラはダウンロードした tarball を、その版のリリースに載っている SHA256 と照合する
mise_version="v2026.9.12"
mise_bin="${HOME}/.local/bin/mise"
if [ ! -x "${mise_bin}" ]; then
  curl -fsSL https://mise.run | MISE_VERSION="${mise_version}" MISE_INSTALL_PATH="${mise_bin}" sh
fi

# ~/.config/mise/config.toml に書いたツールを入れる。
# mise は zip も自前で展開するので、asdf のときのように unzip を入れておく必要はない
"${mise_bin}" install
