#!/bin/bash

# if ! command -v brew > /dev/null 2>&1; then
#   echo "Installing homebrew"
#   /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
#   eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
# fi
#
# if [ -f "$HOME/.Brewfile" ]; then
#   echo "Updating homebrew bundle"
#   brew bundle --global
# fi

if ! command -v curl > /dev/null 2>&1; then
  echo "curl is not found. Please install curl"
  exit 1
fi

if ! command -v git > /dev/null 2>&1; then
  echo "git is not found. Please install git"
  exit 1
fi

# asdf の ghq / terraform / awscli プラグインは zip を展開するので unzip が要る。
# devcontainer のイメージには入っていないことが多いので、root で apt が使えるなら入れる
if ! command -v unzip > /dev/null 2>&1 && [ "$(id -u)" = 0 ] && command -v apt-get > /dev/null 2>&1; then
  apt-get update && apt-get install -y --no-install-recommends unzip
fi

if [ ! -e "${HOME}/.history" ]; then
  mkdir -p "${HOME}/.history"
fi

# ~/.bashrc はディストリビューションが最初から置いていて yadm では上書きできないので、
# yadm で管理している ~/.config/bash/bashrc を読み込む行を追記する
bashrc_source='[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/bash/bashrc" ] && . "${XDG_CONFIG_HOME:-$HOME/.config}/bash/bashrc"'
if ! grep -qxF "${bashrc_source}" "${HOME}/.bashrc" 2>/dev/null; then
  echo "${bashrc_source}" >> "${HOME}/.bashrc"
fi

# `git config --global` の書き込み先は、~/.gitconfig が無いと ~/.config/git/config (yadm で管理) になる。
# devcontainer では VSCode や postStartCommand がそこに credential helper や include を足すので、
# yadm の作業ツリーが汚れないよう空の ~/.gitconfig を用意して書き込み先をそちらに寄せる
touch "${HOME}/.gitconfig"

if [ ! -e "${HOME}/.asdf/asdf.sh" ]; then
  git clone https://github.com/asdf-vm/asdf.git "${HOME}"/.asdf --branch v0.14.0
fi

# shellcheck disable=SC1090
. ~/.asdf/asdf.sh

plugins=(
  "ruby"
  "nodejs"
  "direnv"
  "ghq"
  "tmux"
  "neovim"
  "golang"
  "sops"
  "saml2aws"
  "shellcheck"
  "ripgrep"
  "fzf"
  "eza"
  "jq"
  "yq"
  "starship"
  "github-cli"
  "terraform"
  "awscli"
  "task"
  )


for plugin in "${plugins[@]}" ; do
  asdf plugin add ${plugin}
done

# `asdf install` は最初に失敗したツールで止まり、残りが入らない。
# devcontainer のイメージによっては依存コマンド (awscli の unzip など) が無いので、
# 1 つずつ入れて失敗したものだけ最後に報告する
failed=()
while read -r tool version _; do
  case "${tool}" in ""|\#*) continue ;; esac
  asdf install "${tool}" "${version}" || failed+=("${tool}")
done < "${HOME}/.tool-versions"

if [ "${#failed[@]}" -gt 0 ]; then
  echo "asdf install に失敗しました: ${failed[*]}" >&2
  exit 1
fi
