# shellcheck shell=bash
# bash 用の設定。~/.config/zsh/.zshrc と同じ内容を bash で使えるものに絞って書いている。
# ~/.bashrc はディストリビューションが最初から置いていて yadm では上書きできないため、
# yadm の bootstrap が ~/.bashrc の末尾にこのファイルを読み込む行を追記する

case $- in
  *i*) ;;
  *) return ;;
esac

# bootstrap.sh が yadm を置く場所
case ":${PATH}:" in
  *":${HOME}/.local/bin:"*) ;;
  *) export PATH="${HOME}/.local/bin:${PATH}" ;;
esac

# Setup mise
# mise の shims を PATH の末尾に入れる (`mise activate` は先頭に入れるので使わない)。
# コンテナではプロジェクト側がツールの版を固定していることがあるので、
# 環境に既にあるものを優先し、mise は無いものを補う
mise_shims="${MISE_DATA_DIR:-${XDG_DATA_HOME:-${HOME}/.local/share}/mise}/shims"
case ":${PATH}:" in
  *":${mise_shims}:"*) ;;
  *) export PATH="${PATH}:${mise_shims}" ;;
esac
unset mise_shims

# pager を ov にする。ov が無い環境 (devcontainer など) では less のまま。
# PAGER は短い出力を画面に残したいツールからも使われるので -F (1 画面なら終了) を付けない。
# man も MANPAGER が無ければ PAGER を使うので ov になる
#
# delta の pager は DELTA_PAGER で別に指定する。delta の navigate = true が付ける見出し
# (Δ / added: など) をファイル単位の区切りにし、区切りの行を画面上部に固定する。
# hunk の見出し (•) は検索の対象にしてジャンプしやすくする
if command -v ov > /dev/null 2>&1; then
  export PAGER=ov
  export DELTA_PAGER="ov -F --section-delimiter '^(commit|added:|removed:|renamed:|Δ)' --section-header --pattern '•'"
fi

if command -v nvim > /dev/null 2>&1; then
  export EDITOR=nvim
  alias vi='nvim'
fi

# starship
command -v starship > /dev/null 2>&1 && eval "$(starship init bash)"

# fzf (0.48 以降は --bash で補完とキーバインドを出力できる)
if command -v fzf > /dev/null 2>&1; then
  if fzf_bash="$(fzf --bash 2>/dev/null)"; then eval "${fzf_bash}"; fi
fi

# Setup direnv
command -v direnv > /dev/null 2>&1 && eval "$(direnv hook bash)"

# craete alias for cli tools
alias k='kubectl'
alias gcd='cd `ghq root`/`ghq list | fzf --preview "bat --color=always --style=header,grid --line-range :100 $(ghq root)/{}/README.*"`'
